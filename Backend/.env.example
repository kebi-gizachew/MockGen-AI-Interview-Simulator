# Server
PORT=5000
NODE_ENV=development

# Auth
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# PostgreSQL (Prisma uses this URL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_interview_coach?schema=public"

# AI provider (gemini or mock; if GEMINI_API_KEY is missing/empty, the mock provider is used)
AI_PROVIDER=gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
